# Copy to .env and fill in. Placeholders only: never commit real values.
SERVER_PORT=8080
DB_URL=
DB_USER=
DB_PASSWORD=
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=
TEST_DATABASE_URL=
TEST_DATABASE_USER=
TEST_DATABASE_PASSWORD=
# Field encryption (required: the service does not start without a key): id=base64 of a 32-byte key, comma separated
FIELD_ENCRYPTION_CURRENT_KEY_ID=
FIELD_ENCRYPTION_KEYS=
# Docker (deploy/compose.yml): placeholders only. JWT_PUBLIC_KEY is also read from here (single quotes, PEM with literal \n).
PG_DATABASE=
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=
COMMERCIAL_RESERVATION_APP_PASSWORD=
API_HOST_PORT=
# Where the cash api answers "is the cash open?" (empty: no cash payment is accepted)
CASH_REPORTING_BASE_URL=
# SERVICE token of this api for the internal routes of the cash (HU-COM-009); issued by multi-tour-security, never committed
CASH_REPORTING_SERVICE_TOKEN=
